{
    "if": {
      "field": "type",
      "in": ["AKS Engine", "Microsoft.Kubernetes/connectedClusters", "Microsoft.ContainerService/managedClusters"]
    },
    "then": {
      "effect": "[parameters('effect')]",
      "details": {
        "templateInfo": {
          "sourceType": "PublicURL",
          "url": "https://store.policy.core.windows.net/kubernetes/allowed-seccomp-profiles/v2/template.yaml"
        },
        "excludedNamespaces": "[parameters('excludedNamespaces')]",
        "namespaces": "[parameters('namespaces')]",
        "values": {
          "allowedProfiles": "[parameters('allowedProfiles')]",
          "excludedContainers": "[parameters('excludedContainers')]"
        },
        "apiGroups": [""],
        "kinds": ["Pod"]
      }
    }
}
