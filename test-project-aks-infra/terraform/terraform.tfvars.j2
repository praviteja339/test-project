tags = {
    environment = "{{ env | lower }}"
    owner = "test-devops"
    "deployment model" = "terraform"
    "created on date" = "{{ '%Y-%m-%d' | strftime(ansible_date_time.epoch | int ) }}"
}

env = "{{ env }}"
location = "{{ location }}"
country = "{{ country }}"
region = "{{ region }}"
subscription_id = "{{ subscription_id }}"
service_principal_id = "{{ service_principal_id }}"
service_principal_secret = "{{ service_principal_secret }}"
tenant_id = "{{ tenant_id }}"
resource_group_name = "{{ resource_group_name }}"
node_resource_group_name = "{{ node_resource_group_name }}"

aks_vnet_name = "{{ aks_vnet_name }}"
aks_vnet_cidr = "{{ aks_vnet_cidr }}"
aks_subnet_name = "{{ aks_subnet_name }}"
aks_subnet_cidr = "{{ aks_subnet_cidr }}"
aks_network_security_group_name = "{{ aks_network_security_group_name }}"

aks_to_peer_name = "{{ aks_to_peer_name }}"
peer_to_aks_name = "{{ peer_to_aks_name }}"
aks_peer_vnet_name = "{{ aks_peer_vnet_name }}"
aks_peer_rg_name = "{{ aks_peer_rg_name }}"
aks_to_encoder_peer_name = "{{ aks_to_encoder_peer_name }}"
