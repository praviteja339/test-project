nginx_dragon_repository = "{{ nginx_dragon_repository }}"
nginx_dragon_chart = "{{ nginx_dragon_chart }}"
nginx_dragon_namespace = "{{ nginx_dragon_namespace }}"
dragon_nginx_chart_ver = "{{ dragon_nginx_chart_ver }}"
