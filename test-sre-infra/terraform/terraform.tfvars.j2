tags = {
    environment = "{{ env | lower }}"
    owner = "test-devops"
    "deployment model" = "terraform"
    "created on date" = "{{ '%Y-%m-%d' | strftime(ansible_date_time.epoch | int ) }}"
}

env = "{{ env }}"
location = "{{ location }}"
country = "{{ country }}"
region = "{{ region }}"
subscription_id = "{{ subscription_id }}"
service_principal_id = "{{ service_principal_id }}"
